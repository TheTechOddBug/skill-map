{
  "name": "ui",
  "version": "0.1.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "node scripts/stamp-dev-index.mjs && ng serve --configuration=local",
    "dev:demo": "ng serve --configuration=dev-demo",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "FORCE_COLOR=1 node scripts/quiet-test.mjs",
    "bundle-analyze": "pnpm build --configuration=analyze && source-map-explorer dist/ui/browser/*.js --no-border-checks",
    "validate": "pnpm validate:compile && pnpm validate:test",
    "links:check": "node scripts/check-external-links.mjs",
    "validate:compile": "pnpm links:check && pnpm build",
    "validate:test": "pnpm test:ci"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "@angular/router": "21.2.17",
    "@foblex/flow": "19.1.6",
    "@foblex/flow-dagre-layout": "19.1.6",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@primeuix/themes": "2.0.3",
    "@sentry/angular": "10.69.0",
    "d3-force": "3.0.0",
    "dompurify": "3.4.13",
    "highlight.js": "11.11.1",
    "markdown-it": "14.3.0",
    "posthog-js": "1.413.3",
    "primeicons": "7.0.0",
    "primeng": "21.1.9",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.17",
    "@angular/cli": "21.2.17",
    "@angular/compiler-cli": "21.2.17",
    "@types/d3-force": "3.0.10",
    "@types/markdown-it": "14.1.2",
    "jsdom": "29.1.1",
    "source-map-explorer": "2.5.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
