{
  "name": "skill-map-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end / smoke tests for skill-map. Not a published workspace.",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --project=smoke",
    "test:ui": "pnpm test:ci",
    "test:smoke": "playwright test --project=smoke",
    "test:live-bff": "playwright test --project=live-bff",
    "install:browsers": "playwright install chromium",
    "prevalidate:test": "pnpm install:browsers && pnpm --filter @skill-map/web demo:build",
    "validate": "pnpm validate:test",
    "validate:test": "pnpm test:ci"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.7.0",
    "typescript": "5.9.3"
  }
}
