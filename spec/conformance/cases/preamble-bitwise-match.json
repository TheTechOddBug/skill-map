{
  "$schema": "https://skill-map.ai/spec/v0/conformance-case.schema.json",
  "id": "preamble-bitwise-match",
  "description": "Rendered job content contains the canonical preamble byte-for-byte. Scans a single markdown node, submits a markdown-summarizer job over it (setup.priorInvokes), then asserts `sm job preview --last` prints content containing `preamble-v2.txt` verbatim.",
  "fixture": "preamble-bitwise-match",
  "setup": {
    "priorScans": [{ "fixture": "preamble-bitwise-match" }],
    "priorInvokes": [
      {
        "verb": "job",
        "sub": "submit",
        "args": ["markdown-summarizer"],
        "flags": ["-n", "notes.md"]
      }
    ]
  },
  "invoke": {
    "verb": "job",
    "sub": "preview",
    "flags": ["--last"]
  },
  "assertions": [
    { "type": "exit-code", "value": 0 },
    { "type": "stdout-contains-verbatim", "fixture": "preamble-v2.txt" }
  ]
}
