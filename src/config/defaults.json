{
  "schemaVersion": 1,
  "allowEditSmFiles": false,
  "allowSidecarWriters": true,
  "tutorialReminderDismissed": false,
  "tokenizer": "cl100k_base",
  "server": {
    "port": 4242,
    "host": "127.0.0.1"
  },
  "roots": [],
  "ignore": [],
  "scan": {
    "tokenize": true,
    "strict": false,
    "maxFileSizeBytes": 1048576,
    "maxScan": 5000,
    "maxNodes": 256,
    "watch": {
      "debounceMs": 300,
      "backend": "chokidar"
    },
    "referencePaths": [],
    "followExternalSymlinks": false,
    "respectGitignore": false
  },
  "plugins": {},
  "jobs": {
    "ttlSeconds": 3600,
    "graceMultiplier": 3,
    "minimumTtlSeconds": 60,
    "perActionTtl": {},
    "perActionPriority": {},
    "retention": {
      "completed": 2592000,
      "failed": null
    }
  }
}
