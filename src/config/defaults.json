{
  "schemaVersion": 1,
  "allowEditSmFiles": false,
  "allowSidecarWriters": true,
  "tokenizer": "cl100k_base",
  "roots": [],
  "ignore": [],
  "scan": {
    "tokenize": true,
    "strict": false,
    "maxFileSizeBytes": 1048576,
    "maxScan": 50000,
    "maxNodes": 256,
    "watch": {
      "debounceMs": 300
    },
    "referencePaths": []
  },
  "plugins": {},
  "jobs": {
    "ttlSeconds": 3600,
    "graceMultiplier": 3,
    "minimumTtlSeconds": 60,
    "perActionTtl": {},
    "perActionPriority": {},
    "retention": {
      "completed": 2592000,
      "failed": null
    }
  }
}
