{
  "schemaVersion": 1,
  "allowEditSmFiles": false,
  "allowNetworkActions": false,
  "allowSidecarWriters": true,
  "tutorialReminderDismissed": false,
  "tokenizer": "cl100k_base",
  "server": {
    "port": 4242,
    "host": "127.0.0.1"
  },
  "roots": [],
  "ignore": [],
  "scan": {
    "tokenize": true,
    "strict": false,
    "maxFileSizeBytes": 1048576,
    "maxScan": 5000,
    "maxNodes": 256,
    "watch": {
      "debounceMs": 300,
      "backend": "chokidar"
    },
    "referencePaths": [],
    "followExternalSymlinks": false,
    "respectGitignore": false
  },
  "plugins": {},
  "jobs": {
    "claimWaitSeconds": 2,
    "perExtensionTtl": {},
    "perExtensionPriority": {},
    "retention": {
      "completed": 2592000,
      "failed": null,
      "cancelled": 2592000
    }
  }
}
