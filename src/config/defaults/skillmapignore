# Default `.skill-mapignore` shipped by `sm init`. Anything matching is
# skipped during `sm scan`. Same syntax as `.gitignore` (kaelzhang/ignore).
# Edit freely after `sm init`, the file is owned by the user from then on.

# Version-control + dependency dirs
.git/
node_modules/

# Build output
dist/
build/
out/
.next/
.cache/

# Project-local transient artifacts
.tmp/
.skill-map/

# skill-map's own materialised agent-process skill (`sm agent install`).
# Infrastructure, not project content: it never appears as a node in the
# map / server. Re-include with `!sm-process-jobs/` if you want it scanned.
sm-process-jobs/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Logs
*.log
