{
  "$schema": "https://skill-map.ai/spec/v0/conformance-case.schema.json",
  "id": "basic-scan",
  "description": "Scanning the minimal-agent-skills fixture detects exactly one `skill` node at the open-standard path `.agents/skills/<name>/SKILL.md` with no issues.",
  "fixture": "minimal-agent-skills",
  "invoke": {
    "verb": "scan",
    "flags": ["--json"]
  },
  "assertions": [
    { "type": "exit-code", "value": 0 },
    { "type": "json-path", "path": "$.schemaVersion", "equals": 1 },
    { "type": "json-path", "path": "$.stats.nodesCount", "equals": 1 },
    { "type": "json-path", "path": "$.stats.issuesCount", "equals": 0 },
    { "type": "json-path", "path": "$.nodes.length", "equals": 1 }
  ]
}
