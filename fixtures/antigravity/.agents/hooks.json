{
  "skill-map-activity": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ../.skill-map/activity/bridge.js antigravity"
          }
        ],
        "matcher": "^(view_file|call_mcp_tool|write_to_file|replace_file_content)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ../.skill-map/activity/bridge.js antigravity"
          }
        ],
        "matcher": "^run_command$"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../.skill-map/activity/bridge.js antigravity"
      }
    ]
  }
}
