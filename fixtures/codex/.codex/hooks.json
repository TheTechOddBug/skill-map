{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .skill-map/activity/bridge.js codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .skill-map/activity/bridge.js codex"
          }
        ],
        "matcher": "^(spawn_agent|mcp__.+)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .skill-map/activity/bridge.js codex"
          }
        ],
        "matcher": "^spawn_agent$"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .skill-map/activity/bridge.js codex"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .skill-map/activity/bridge.js codex"
          }
        ]
      }
    ]
  }
}
